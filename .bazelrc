# Host toolchain settings (tests, IDE-indexing libs). The firmware build sets
# its own flags via platformio_project build_flags.
build --cxxopt=-std=c++17
test --test_output=errors

# libc++ everywhere (project policy): identical std::*_distribution streams on
# macOS and Linux, so rendered goldens match across platforms. On Linux this
# requires clang (CC=clang) with libc++-dev/libc++abi-dev installed.
common --enable_platform_specific_config
build:linux --repo_env=CC=clang
build:linux --cxxopt=-stdlib=libc++
build:linux --linkopt=-stdlib=libc++

# Run tests under AddressSanitizer: bazel test --config=asan //test:all
build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address --copt=-g
