load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    "@platformio_rules//platformio:platformio.bzl",
    "platformio_library",
    "platformio_project",
)

# Host-compilable core logic (no Arduino dependency) so //test can exercise
# it on the development machine. SinWave/BurningFlambeos are excluded: they
# use Teensy-only M_TWOPI.
cc_library(
    name = "core",
    srcs = [
        "Control.cpp",
        "clock.cpp",
    ],
    hdrs = [
        "Color.h",
        "Context.h",
        "Control.h",
        "ExampleSequence.h",
        "ParticleEffectSequence.h",
        "ParticleSequenceBase.h",
        "SequenceBase.h",
        "SinWaveSequence.h",
        "SoundData.h",
        "SoundHistogramSequence.h",
        "SoundReactiveParticleEffectSequence.h",
        "clock.h",
        "ledmath.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "lib_clion",
    srcs = glob([
        "**/*.cc",
        "**/*.cpp",
        "**/*.h",
    ]),
    copts = [
        # Just to make autocomplete happy
        "-I/Applications/Teensyduino.app/Contents/Java/hardware/teensy/avr/cores/teensy4",
        "-I/Applications/Teensyduino.app/Contents/Java/hardware/teensy/avr/libraries/Audio",
        "-I/Applications/Teensyduino.app/Contents/Java/hardware/teensy/avr/libraries/Wire",
        "-I/Applications/Teensyduino.app/Contents/Java/hardware/teensy/avr/libraries/SD/src",
        "-I/Applications/Teensyduino.app/Contents/Java/hardware/teensy/avr/libraries/SerialFlash",
        "-DSEREMU_INTERFACE",

        # TO make SPI happy
        "-D__arm__",
        "-D__IMXRT1052__",
        "-DTEENSYDUINO",
        #        "-DKINETISK",
        #        "-target",
        #        "armv7-none-eabihf",
    ],
    # IDE-indexing target only; requires Teensyduino installed locally.
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "@SPI//:SPI_clion",
        "@TeensyDMX//:TeensyDMX_clion",
    ],
)

platformio_library(
    name = "lib_headers",
    src = "lib_headers_empty.cc",
    add_hdrs = [
        "clock.h",
        "Context.h",
        "Color.h",
        "ledmath.h",
        "SequenceBase.h",
        "Control.h",
        "ExampleSequence.h",
        "BurningFlambeosSequence.h",
        "SinWaveSequence.h",
        "ParticleEffectSequence.h",
        "ParticleSequenceBase.h",
        "SoundHistogramSequence.h",
        "SoundReactiveParticleEffectSequence.h",
        "SoundData.h",
    ],
    add_srcs = [
        "Control.cpp",
        "clock.cpp",
    ],
    hdr = "lib_headers_empty.h",
)

